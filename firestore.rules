rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Blog posts — anyone can read published, only admin can write
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "maddydragon85@gmail.com";
    }

    // Users — each user reads/writes own profile; admin reads all
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if request.auth != null
        && request.auth.token.email == "maddydragon85@gmail.com";
    }

    // Cases — client reads own cases; admin reads and writes all
    match /cases/{caseId} {
      allow read: if request.auth != null
        && request.auth.token.email == resource.data.clientEmail;
      allow read, write: if request.auth != null
        && request.auth.token.email == "maddydragon85@gmail.com";
    }
  }
}
